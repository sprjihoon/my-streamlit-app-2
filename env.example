# ═══════════════════════════════════════════════════════════
# 환경 변수 설정 예시
# ═══════════════════════════════════════════════════════════
# 이 파일을 복사하여 .env 파일을 생성하세요:
#   cp env.example .env
#
# 주의: .env 파일은 절대 Git에 커밋하지 마세요!
# ═══════════════════════════════════════════════════════════

# ─────────────────────────────────────
# 앱 설정
# ─────────────────────────────────────
APP_NAME=Billing API
APP_VERSION=1.0.0
DEBUG=false

# ─────────────────────────────────────
# 서버 설정
# ─────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ─────────────────────────────────────
# 데이터베이스
# ─────────────────────────────────────
DATABASE_PATH=billing.db

# ─────────────────────────────────────
# CORS 설정 (프로덕션용)
# ─────────────────────────────────────
# 로컬 개발: http://localhost:3000
# 프로덕션: 실제 프론트엔드 도메인으로 변경
# 여러 도메인: http://localhost:3000,https://app.example.com
CORS_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# ─────────────────────────────────────
# 파일 업로드
# ─────────────────────────────────────
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE=52428800

# ─────────────────────────────────────
# 보안 (프로덕션에서 반드시 변경!)
# ─────────────────────────────────────
SECRET_KEY=change-this-to-a-secure-random-string

# ─────────────────────────────────────
# 프론트엔드 설정 (Next.js)
# ─────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─────────────────────────────────────
# 네이버 웍스 Bot 설정
# ─────────────────────────────────────
NAVER_WORKS_DOMAIN_ID=300067330
NAVER_WORKS_BOT_ID=11582726
NAVER_WORKS_BOT_SECRET=your-bot-secret
NAVER_WORKS_CLIENT_ID=your-client-id
NAVER_WORKS_CLIENT_SECRET=your-client-secret
NAVER_WORKS_SERVICE_ACCOUNT=your-service-account@domain.by-works.com
NAVER_WORKS_PRIVATE_KEY_PATH=private_key.key

# ─────────────────────────────────────
# OpenAI API 설정
# ─────────────────────────────────────
OPENAI_API_KEY=sk-your-api-key

# ─────────────────────────────────────
# 우체국 계약소포 (Infront 회수신청)
# 실제 키는 Railway 환경변수에만 넣고 커밋하지 마세요.
# ─────────────────────────────────────
EPOST_API_KEY=
EPOST_SECURITY_KEY=
EPOST_CUSTOMER_ID=
EPOST_APPROVAL_NO=
EPOST_OFFICE_SER=260940699
INFRONT_CENTER_ORD_NM=스프링풀필먼트
INFRONT_CENTER_NAME=스프링풀필먼트
INFRONT_CENTER_ZIPCODE=41142
INFRONT_CENTER_ADDR1=대구광역시 동구 동촌로 1
INFRONT_CENTER_ADDR2=동대구우체국 2층 소포실
INFRONT_CENTER_PHONE=

